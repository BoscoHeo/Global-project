rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🔒 [보안 강화] 모든 클라이언트의 Firestore 직접 읽기/쓰기 차단
    // 우리 애플리케이션의 모든 데이터(학급 암호, 포트폴리오, 모둠 PIN, 실시간 채팅 등)는
    // 백엔드 Express 서버(Node.js)를 통해서만 안전하게 인증 및 검증 후 입출력됩니다.
    // 브라우저 클라이언트가 Firebase 환경 설정값을 악용하여 직접 DB를 열람/변조/삭제하는 것을 전면 차단합니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

